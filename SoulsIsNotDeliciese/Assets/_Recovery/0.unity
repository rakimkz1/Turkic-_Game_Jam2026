  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The day had come to become a man... \nor so you thought when you went
    boar \nhunting alone. You returned in tears \nafter being thoroughly defeated
    by the \nboar. When our jezde heard about it, \nKotibar Batyr gifted you his
    helmet. You \nstill haven't gone hunting with it. \n<color=red>(The lid now deals
    damage, \nand souls move slightly faster.)</color>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e90a37a52e801e540a737a0a11edf923, type: 2}
  m_sharedMaterial: {fileID: 4840213342337753578, guid: e90a37a52e801e540a737a0a11edf923, type: 2}
