  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "You always admired how swiftly \nyour father rode across the steppe. \nSadly,
    you've never been much of \na rider yourself. Still, he gave you \nhis whip...
    so at least you'd learn to \nmove faster than a sleepy camel. \n<color=red>(Speeds
    up the lid, but makes it shakier.)</color>"
  m_isRightToLeft: 0
