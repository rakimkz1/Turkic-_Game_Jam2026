      animCrossFades: 0
  - DayStartReplices:
    - Replices: "\u0414\u043E\u0431\u0440\u043E\u0439 \u043D\u043E\u0447\u0438, \u041B\u043E\u0448\u043E\u043A!"
      AnimPos: 'DefaultFaceSpeech2 '
