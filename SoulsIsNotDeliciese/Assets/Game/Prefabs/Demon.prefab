    m_PreInfinity: 2
    m_PostInfinity: 2
    m_RotationOrder: 4
  replices:
  - DayStartReplices:
    - Replices: "\u0412\u0430\u0430!!!"
      AnimPos: DemonAppear
      animCrossFades: 0
    - Replices: "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E, \u041B\u043E\u0448\u0430\u0440\u0430!
        \u041E\u0439, \u044F \u043E\u0448\u0438\u0431\u0441\u044F, \u044F \u0438\u043C\u0435\u043B
        \u0432\u0432\u0438\u0434\u0443... \u041D\u043E\u0447\u044C! \u0414\u0430!"
      AnimPos: DemonDefaultPose
      animCrossFades: 0
    - Replices: "\u0427\u0435\u0433\u043E \u0445\u043C\u0443\u0440\u044B\u0439 \u0442\u0430\u043A\u043E\u0439,
        \u043D\u0435 \u0443\u0437\u043D\u0430\u0435\u0448\u044C \u044D\u0442\u043E
        \u043C\u0435\u0441\u0442\u043E? \u042D\u0442\u043E \u0436\u0435 \u0442\u0432\u043E\u0439
        \u0434\u043E\u043C, \u0411\u0430\u043B\u0431\u0435\u0441!"
      AnimPos: DefaultFaceSpeech1
      animCrossFades: 0
    - Replices: "\u041D\u0443 \u0438 \u0434\u0435\u0440\u044C\u043C\u043E. \u0425\u0432\u0430\u0442\u0438\u0442
        \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u043E\u0432\u0435\u0446 \u043D\u0430
        \u043D\u0435\u0431\u0435 \u0438 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u044C
        \u043C\u043D\u0435 \u0447\u0442\u043E \u043D\u0438 \u0431\u0443\u0434\u044C."
      AnimPos: DefaultFaceSpeech1
      animCrossFades: 0
    - Replices: "\u0418 \u0447\u0435\u0433\u043E \u0441\u0442\u043E\u0438\u0448\u044C?
        \u0414\u0443\u043C\u0430\u0435\u0448\u044C \u043C\u043E\u0436\u0435\u0448\u044C
        \u043C\u043D\u0435 \u043F\u0435\u0440\u0435\u0447\u0438\u0442\u044C? "
      AnimPos: DefaultFaceSpeech3
      animCrossFades: 0
    - Replices: "\u0425\u0430\u0445, \u044F \u0431\u044B \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
        \u043D\u0430 \u0442\u0432\u043E\u044E \u043D\u0435\u0441\u0433\u0438\u0431\u0430\u0435\u043C\u043E\u0441\u0442\u044C
        \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u0443\u0432\u0438\u0434\u0438\u0448\u044C
        \u0441\u0432\u043E\u044E \u0441\u0435\u043C\u044C\u044E."
      AnimPos: DefaultFaceSpeech2
      animCrossFades: 0
    - Replices: "\u0414\u0430-\u0434\u0430, \u0442\u0432\u043E\u044F \u0441\u0435\u043C\u044C\u044F
        \u0442\u0443\u0442! \u0412\u0441\u0435 \u0441\u0435\u043C\u0435\u0440\u043E,
        \u043A\u0430\u043A \u0442\u0435 \u043A\u043E\u0437\u043B\u044F\u0442\u0430.
        \u0410 \u044F \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F
        \u0432\u043E\u043B\u043A."
      AnimPos: 'ShowFamily '
      animCrossFades: 0
    - Replices: "\u041E, \u0443\u0436\u0435 \u0440\u0432\u0435\u0448\u044C\u0441\u044F
        \u0438 \u043C\u0435\u0447\u0435\u0448\u044C? \u0420\u0430\u0434 \u0441\u043B\u044B\u0448\u0430\u0442\u044C,
        \u0442\u043E\u0433\u0434\u0430 \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C
        \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C, \u044F \u043F\u0440\u043E\u0433\u043E\u043B\u043E\u0434\u0430\u043B\u0441\u044F."
      AnimPos: JoyPose2
      animCrossFades: 0
    - Replices: "... \u0422\u044B \u0447\u0442\u043E, \u043D\u0438\u043A\u043E\u0433\u0434\u0430
        \u0432 \u0436\u0438\u0437\u043D\u0438 \u043D\u0435 \u0433\u043E\u0442\u043E\u0432\u0438\u043B?"
      AnimPos: DefaultFaceSpeech1
      animCrossFades: 0
    - Replices: "\u0412\u043E\u0442 \u0436\u0435 \u0436 \u0431\u0435\u0441\u0442\u043E\u043B\u043E\u0447\u044C,
        \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u0442\u0435\u0431\u044F
        \u0432\u0441\u0435\u043C\u0443 \u043E\u0431\u0443\u0447\u0430\u0442\u044C."
      AnimPos: DefaultFaceSpeech1
      animCrossFades: 0
    - Replices: "\u0418 \u0442\u0430\u043A, \u0441\u043B\u0443\u0448\u0430\u0439
        \u0441\u044E\u0434\u0430, \u041B\u043E\u0448\u0430\u0440\u0430, \u0441\u043F\u0440\u0430\u0432\u0430
        \u043E\u0442 \u0442\u0435\u0431\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
        \u043F\u043E\u043B\u043A\u0430, \u0433\u0434\u0435 \u043F\u043E\u043A\u043E\u044F\u0442\u0441\u044F
        \u0442\u0432\u043E\u0438 \u043F\u0440\u0435\u0434\u043A\u0438."
      AnimPos: ShowSpirits
      animCrossFades: 0
    - Replices: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0438\u0437 \u043D\u0438\u0445
        \u0434\u0430\u0435\u0442 \u0442\u0435\u0431\u0435 \u0441\u0438\u043B\u0443,
        \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u0443\u044E. \u0412\u044B\u0431\u0435\u0440\u0438
        \u0442\u0443 \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043D\u0435 \u0436\u0430\u043B\u043A\u043E
        \u0438 \u0437\u0430\u043A\u0438\u0434\u044B\u0432\u0430\u0439 \u0432 \u043A\u043E\u0442\u0435\u043B."
      AnimPos: 'ShowBoiler '
      animCrossFades: 0
    - Replices: "\u0418 \u043F\u043E\u0431\u044B\u0441\u0442\u0440\u0435\u0435! \u042F
        \u0433\u043E\u043B\u043E\u0434\u0435\u043D \u0438 \u0433\u043E\u0442\u043E\u0432
        \u0441\u044A\u0435\u0441\u0442\u044C \u0441\u0435\u043C\u0435\u0440\u044B\u0445
        \u0442\u0432\u043E\u0438\u0445 \u0441\u0435\u043C\u044C\u0438, \u0435\u0441\u043B\u0438
        \u0442\u044B \u043D\u0435 \u043F\u043E\u0442\u043E\u0440\u043E\u043F\u0438\u0448\u044C\u0441\u044F!"
      AnimPos: SmilePose2
      animCrossFades: 0
    FoodEndReplices:
    - Replices: "Default Replices#JoyPose1\r\n\u0423\u0443\u0443\u0445\u0445, \u0432\u044B\u0448\u043B\u043E
        \u043E\u0447\u0435\u043D\u044C \u0434\u0430\u0436\u0435 \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u043D\u043E!
        \u0418\u0437 \u0442\u0435\u0431\u044F \u0445\u043E\u0440\u043E\u0448\u0438\u0439
        \u043F\u043E\u0432\u0430\u0440, \u0410?!"
      AnimPos: DemonDefaultPose
      animCrossFades: 0
    - Replices: "Default Replices#JoyPose1\r\n\u0418 \u0447\u0435\u0433\u043E \u0442\u044B
        \u0442\u0430\u043A \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0438\u043B\u0441\u044F?
        \u0427\u0435, \u043F\u0440\u0435\u0434\u043A\u043E\u0432 \u0436\u0430\u043B\u043A\u043E
        \u0441\u0442\u0430\u043B\u043E? "
      AnimPos: DemonDefaultPose
      animCrossFades: 0
    - Replices: "Default Replices#DefaultFaceSpeech2 \r\n\u0414\u0430 \u0437\u0430\u0431\u0435\u0439
        \u0442\u044B \u043D\u0430 \u043D\u0438\u0445. \u041E\u043D\u0438 \u0441\u0432\u043E\u0435
        \u0443\u0436\u0435 \u043F\u0440\u043E\u0436\u0438\u043B\u0438, \u0438 \u043F\u0443\u0441\u043A\u0430\u0439
        \u0443\u0436\u0435 \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
        \u0441\u0433\u0438\u043D\u0443\u0442! \u0410 \u0442\u0435\u0431\u0435 \u043D\u0430\u0434\u043E
        \u0441\u0432\u043E\u044E \u0448\u043A\u0443\u0440\u0443 \u0441\u043F\u0430\u0441\u0430\u0442\u044C!"
      AnimPos: DemonDefaultPose
      animCrossFades: 0
    - Replices: "Default Replices#SmilePose1\r\n\u041D\u0443... \u0421\u0432\u043E\u044E
        \u0441\u0435\u043C\u044C\u044E, \u0434\u0430."
      AnimPos: DemonDefaultPose
      animCrossFades: 0
    - Replices: "Default Replices#ShowCandle\r\n\u041B\u0430\u0434\u043D\u043E, \u043F\u0440\u043E\u0435\u0445\u0430\u043B\u0438.
        \u0412\u0438\u0434\u0438\u0448\u044C \u0442\u0443 \u0441\u0432\u0435\u0447\u043A\u0443?
        \u0421\u0434\u0443\u0439 \u043A\u0430 \u043E\u0434\u043D\u0443 \u0438\u0437
        \u0435\u0433\u043E \u043F\u043B\u0430\u043C\u0435\u043D\u0435\u0439."
      AnimPos: DemonDefaultPose
      animCrossFades: 0
    - Replices: "Default Replices#SmilePose1\r\n\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E
        \u0441\u0442\u0430\u043B\u043E \u0447\u0442\u043E \u0437\u0430 \u0441\u0432\u0435\u0447\u0430? "
      AnimPos: DemonDefaultPose
      animCrossFades: 0
    - Replices: "Default Replices#JoyPose1\r\n\u041D\u0443, \u0442\u0430\u043A\u043E\u043C\u0443
        \u0442\u0443\u043F\u043E\u043C\u0443 \u043A\u0430\u043A \u0442\u044B, \u0441\u043B\u043E\u0436\u043D\u043E
        \u0431\u0443\u0434\u0435\u0442 \u0434\u043E\u0442\u044F\u043D\u0443\u0442\u044C\u0441\u044F
        \u0434\u043E \u043C\u043E\u0438\u0445 \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u044B\u0445
        \u043C\u044B\u0441\u043B\u0435\u0439, \u043D\u043E \u044D\u0442\u043E \u043C\u043E\u044F
        \u043B\u0438\u0447\u043D\u0430\u044F \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0430. "
      AnimPos: DemonDefaultPose
      animCrossFades: 0
    - Replices: "Default Replices#JoyPose2\r\n\u041A\u0430\u0436\u0434\u044B\u0439
        \u0434\u0435\u043D\u044C \u043D\u0430\u0434\u043E \u0441\u0434\u0443\u0432\u0430\u0442\u044C
        \u043F\u043E \u043E\u0434\u043D\u043E\u0439 \u0438 \u043A\u043E\u0433\u0434\u0430
        \u0432\u0441\u0435 \u043F\u043B\u0430\u043C\u0435\u043D\u0438 \u0443\u0433\u0430\u0441\u043D\u0443\u0442,
        \u044D\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u043E\u0437\u043D\u0430\u0447\u0430\u0442\u044C
        \u043A\u043E\u043D\u0435\u0446 \u043D\u043E\u0432\u043E\u043B\u0443\u043D\u0438\u044E.
        \u0410 \u0437\u043D\u0430\u0447\u0438\u0442 \u0438 \u043A\u043E\u043D\u0435\u0446
        \u043C\u043E\u0435\u0439 \u0441\u0432\u043E\u0431\u043E\u0434\u0435..."
      AnimPos: DemonDefaultPose
      animCrossFades: 0
    - Replices: "Default Replices#DefaultFaceSpeech3\r\n... \u0410\u0436 \u043D\u0430
