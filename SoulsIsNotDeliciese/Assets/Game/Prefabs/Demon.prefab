      animCrossFades: 0
    - Replices: "\u0422\u0430\u043A, \u0441\u043B\u0443\u0448\u0430\u0439 \u0441\u044E\u0434\u0430,
        \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0443 \u043C\u0435\u043D\u044F
        \u0442\u0440\u0443\u0434\u043D\u044B\u0439 \u0434\u0435\u043D\u0435\u043A
        \u0432\u044B\u0434\u0430\u043B\u0441\u044F \u0438 \u044F \u043A\u0443\u0448\u0430\u0442\u044C
        \u0445\u043E\u0447\u0443. \u041F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u044C
        \u043A\u0430 \u043C\u043D\u0435 \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437
        \u0441\u0432\u043E\u0438\u0445 \u0434\u0435\u043B\u0438\u043A\u0430\u0442\u0435\u0441\u043E\u0432!"
      AnimPos: DemonDefaultPose
      animCrossFades: 0
    - Replices: "\u0418 \u0447\u0442\u043E\u0431\u044B \u0431\u0435\u0437 \u044D\u0442\u043E\u0433\u043E
        \u0442\u0432\u043E\u0435\u0433\u043E \u0443\u043F\u0440\u044F\u043C\u0441\u0442\u0432\u0430!
